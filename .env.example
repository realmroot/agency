AMA_DEFAULT_MODEL=@cf/moonshotai/kimi-k2.6
AMA_RUNTIME_MODE=live

# Realmroot public SPA configuration. AMA accepts only DPoP-bound Realmroot tokens.
OIDC_ISSUER=https://id.realmroot.dev/api/auth
OIDC_CLIENT_ID=replace-with-realmroot-public-spa-client-id
OIDC_RESOURCE=https://replace-with-app-host/api
OIDC_BROWSER_SCOPES=openid profile email agents:read sessions:read
AMA_VAULT_ENCRYPTION_KEY=replace-with-32-byte-random-secret
AMA_ALLOWED_ORIGINS=https://replace-with-app-host

# Workers AI is used by the cloud-owned AMA runtime.
AMA_AI_GATEWAY_ID=
