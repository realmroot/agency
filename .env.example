RUNTIME_MODE=live

# Realmroot OAuth configuration. Console and runner clients use Bearer; Agent and Toolbox clients use DPoP.
OIDC_ISSUER=https://id.realmroot.dev/api/auth
OIDC_CLIENT_ID=replace-with-realmroot-public-spa-client-id
OIDC_RUNNER_CLIENT_ID=replace-with-realmroot-runner-client-id
OIDC_RUNNER_SCOPES=openid profile email offline_access runners:read runners:write work-items:read work-items:write leases:read leases:write sessions:write
OIDC_RESOURCE=https://replace-with-app-host/api
INBOX_RESOURCE=https://replace-with-inbox-host/api
INBOX_CLIENT_ID=replace-with-realmroot-machine-client-id
OIDC_BROWSER_SCOPES=openid profile email agents:read sessions:read
VAULT_ENCRYPTION_KEY=replace-with-32-byte-random-secret
ALLOWED_ORIGINS=https://replace-with-app-host

# Workers AI is used by the cloud-owned Enbor runtime when an Agent pins a Cloudflare model.
AI_GATEWAY_ID=
