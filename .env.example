AMA_DEFAULT_MODEL=@cf/moonshotai/kimi-k2.6
AMA_RUNTIME_MODE=live
# Hermetic AMA tests only. Leave unset for real Realmroot enrollment, including
# local three-system smoke runs with AMA_RUNTIME_MODE=test.
AMA_E2E_FAKE_REALMROOT_ENROLLMENT=false

# Realmroot OAuth configuration. Console and runner clients use Bearer; Agent and Toolbox clients use DPoP.
OIDC_ISSUER=https://id.realmroot.dev/api/auth
OIDC_CLIENT_ID=replace-with-realmroot-confidential-web-client-id
OIDC_CLIENT_SECRET=replace-with-realmroot-confidential-web-client-secret
OIDC_TRUSTED_BEARER_CLIENT_IDS=replace-with-trusted-upstream-bff-client-ids
OIDC_RUNNER_CLIENT_ID=replace-with-realmroot-runner-client-id
OIDC_RUNNER_SCOPES=openid profile email offline_access runners:read runners:write work-items:read work-items:write leases:read leases:write sessions:write
OIDC_RESOURCE=https://replace-with-app-host/api
OIDC_BROWSER_SCOPES=openid profile email offline_access agents:read agents:write sessions:read
AMA_VAULT_ENCRYPTION_KEY=replace-with-32-byte-random-secret
AMA_WEB_SESSION_ENCRYPTION_KEY=replace-with-an-independent-32-byte-random-secret
REALMROOT_MANAGEMENT_RESOURCE=https://id.realmroot.dev/api
AMA_ALLOWED_ORIGINS=https://replace-with-app-host

# Workers AI is used by the cloud-owned AMA runtime.
AMA_AI_GATEWAY_ID=
