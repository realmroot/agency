FROM node:24-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e

RUN rm -f /etc/apt/sources.list.d/debian.sources \
  && printf '%s\n' \
    'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20260828T000000Z bookworm main' \
    'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20260828T000000Z bookworm-updates main' \
    'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/20260828T000000Z bookworm-security main' \
    > /etc/apt/sources.list \
  && apt-get update \
  && apt-get install --no-install-recommends --yes ca-certificates git openssh-client \
  && rm -rf /var/lib/apt/lists/*

ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/enbor-runner /usr/local/bin/enbor-runner

USER node
WORKDIR /home/node/workspace

ENTRYPOINT ["enbor-runner"]
CMD ["--help"]
